#!/usr/bin/env python3
"""Run a Spark direct UDF worker inside a Docker Sandbox.

Usage, as the worker command Spark spawns:

  sbx-udf-worker --sandbox NAME [options] -- GUEST_COMMAND... --id ID --connection HOST_SOCKET

Spark appends --id and --connection. A socket bound inside the sandbox belongs
to the guest kernel, so this process binds HOST_SOCKET itself and copies bytes
for each connection through `sbx exec -i`.

A guest supervisor runs the worker in its own process group. It stops that
group when its stdin closes, which happens on SIGTERM and also when this
process is SIGKILLed, so the guest worker never outlives the launcher.
"""

import argparse
import os
import signal
import socket
import subprocess
import sys
import threading

SUPERVISOR = r"""
import os, signal, stat, subprocess, sys, threading, time
sock, grace, timeout = sys.argv[1], float(sys.argv[2]), float(sys.argv[3])
os.makedirs(os.path.dirname(sock), exist_ok=True)
try:
    os.unlink(sock)
except FileNotFoundError:
    pass
worker = subprocess.Popen(sys.argv[4:], start_new_session=True,
                          stdin=subprocess.DEVNULL, stdout=2)
def kill_group(sig):
    try:
        os.killpg(worker.pid, sig)
    except ProcessLookupError:
        pass
def stop_on_eof():
    while os.read(0, 4096):
        pass
    kill_group(signal.SIGTERM)
    try:
        worker.wait(grace)
    except subprocess.TimeoutExpired:
        kill_group(signal.SIGKILL)
threading.Thread(target=stop_on_eof, daemon=True).start()
def is_socket():
    try:
        return stat.S_ISSOCK(os.stat(sock).st_mode)
    except FileNotFoundError:
        return False
deadline = time.monotonic() + timeout
while not is_socket():
    if worker.poll() is not None:
        break
    if time.monotonic() > deadline:
        kill_group(signal.SIGKILL)
        worker.wait()
        sys.exit(124)
    time.sleep(0.05)
else:
    os.write(1, b"ready\n")
code = worker.wait()
kill_group(signal.SIGKILL)
try:
    os.unlink(sock)
except FileNotFoundError:
    pass
sys.exit(code if code >= 0 else 128 - code)
"""

BRIDGE = r"""
import os, socket, sys, threading
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect(sys.argv[1])
def pump_in():
    while True:
        data = os.read(0, 65536)
        if not data:
            s.shutdown(socket.SHUT_WR)
            return
        s.sendall(data)
threading.Thread(target=pump_in, daemon=True).start()
while True:
    data = s.recv(65536)
    if not data:
        break
    os.write(1, data)
"""


def parse(argv):
    if "--" not in argv:
        sys.exit("sbx-udf-worker: expected -- before the guest command")
    split = argv.index("--")
    parser = argparse.ArgumentParser(prog="sbx-udf-worker")
    parser.add_argument("--sandbox", required=True)
    parser.add_argument("--sbx", default="sbx")
    parser.add_argument("--guest-dir", default="/tmp/sbx-udf-workers")
    parser.add_argument("--ready-timeout", type=float, default=60.0)
    parser.add_argument("--grace-period", type=float, default=5.0)
    parser.add_argument("-e", "--env", action="append", default=[],
                        help="forward this host environment variable to the guest")
    parser.add_argument("--log")
    opts = parser.parse_args(argv[:split])
    guest = argv[split + 1:]
    worker_id = None
    host_socket = None
    command = []
    i = 0
    while i < len(guest):
        if guest[i] == "--id" and i + 1 < len(guest):
            worker_id = guest[i + 1]
            command += guest[i:i + 2]
            i += 2
        elif guest[i] == "--connection" and i + 1 < len(guest):
            host_socket = guest[i + 1]
            i += 2
        else:
            command.append(guest[i])
            i += 1
    if not command or worker_id is None or host_socket is None:
        sys.exit("sbx-udf-worker: guest command, --id, and --connection are required")
    return opts, command, worker_id, host_socket


def main():
    opts, command, worker_id, host_socket = parse(sys.argv[1:])
    exec_args = [opts.sbx, "exec", "-i"]
    for name in opts.env:
        if name in os.environ:
            exec_args += ["-e", f"{name}={os.environ[name]}"]
    exec_args.append(opts.sandbox)
    guest_socket = f"{opts.guest_dir}/{worker_id}.sock"
    log = open(opts.log, "a", buffering=1) if opts.log else sys.stderr
    stopping = threading.Event()
    bridges = []

    def trace(message):
        print(f"[sbx-udf-worker {worker_id}] {message}", file=log, flush=True)

    trace(f"host={host_socket} guest={opts.sandbox}:{guest_socket}")
    supervisor = subprocess.Popen(
        exec_args + ["python3", "-u", "-c", SUPERVISOR, guest_socket,
                     str(opts.grace_period), str(opts.ready_timeout)]
        + command + ["--connection", guest_socket],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=log)

    def finish(code):
        for bridge in bridges:
            bridge.kill()
        try:
            os.unlink(host_socket)
        except FileNotFoundError:
            pass
        os._exit(code)

    def stop(*_):
        if stopping.is_set():
            return
        stopping.set()
        trace("stopping")
        supervisor.stdin.close()
        try:
            supervisor.wait(timeout=opts.grace_period + 5)
        except subprocess.TimeoutExpired:
            supervisor.kill()
        finish(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    first_line = []
    answered = threading.Event()

    def read_ready():
        first_line.append(supervisor.stdout.readline())
        answered.set()

    threading.Thread(target=read_ready, daemon=True).start()
    if not answered.wait(opts.ready_timeout + 10):
        trace("guest worker did not become ready")
        supervisor.stdin.close()
        try:
            supervisor.wait(timeout=opts.grace_period + 5)
        except subprocess.TimeoutExpired:
            supervisor.kill()
        finish(1)
    if first_line[0] != b"ready\n":
        code = supervisor.wait()
        trace(f"guest worker exited with {code} before ready")
        finish(code or 1)

    try:
        os.unlink(host_socket)
    except FileNotFoundError:
        pass
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(host_socket)
    server.listen(socket.SOMAXCONN)
    trace("ready")

    def relay(client):
        bridge = subprocess.Popen(
            exec_args + ["python3", "-u", "-c", BRIDGE, guest_socket],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=log)
        bridges.append(bridge)

        def to_guest():
            try:
                while True:
                    data = client.recv(65536)
                    if not data:
                        break
                    bridge.stdin.write(data)
                    bridge.stdin.flush()
            except OSError:
                pass
            try:
                bridge.stdin.close()
            except OSError:
                pass

        threading.Thread(target=to_guest, daemon=True).start()
        fd = bridge.stdout.fileno()
        try:
            while True:
                data = os.read(fd, 65536)
                if not data:
                    break
                client.sendall(data)
        except OSError:
            pass
        client.close()
        bridge.wait()
        bridges.remove(bridge)

    def watch_supervisor():
        code = supervisor.wait()
        if not stopping.is_set():
            trace(f"guest worker exited with {code}")
            finish(code or 1)

    threading.Thread(target=watch_supervisor, daemon=True).start()
    while True:
        client, _ = server.accept()
        threading.Thread(target=relay, args=(client,), daemon=True).start()


if __name__ == "__main__":
    main()
